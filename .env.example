# Provider (only ever set on the harness `run_episode` Modal function via secret `anthropic-secret`)
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE=            # REQUIRED for org-scoped keys: sent as the anthropic-workspace-id header; surfaced masked in run metadata
ANTHROPIC_MODEL=claude-haiku-4-5
FAULTLINE_ANTHROPIC_SECRET=anthropic-secret   # Modal secret name holding the two keys above
HARNESS_HAIKU_THINKING=0       # opt-in extended-thinking budget for Haiku 4.5; default off

# Service wiring (deploy-time)
SANDBOX_ENV_URL=https://appliedlabsai-local--faultline-sandbox-env-api.modal.run
HARNESS_URL=https://appliedlabsai-local--faultline-harness-api.modal.run
MODAL_ENVIRONMENT=local
# FAULTLINE_WEB_PREBUILT=1     # force serving a local apps/web/dist (0 forces an in-image build); unset = use dist/ if present

# Logging
LOG_LEVEL=info                  # debug dumps tool args/outputs (truncated)
